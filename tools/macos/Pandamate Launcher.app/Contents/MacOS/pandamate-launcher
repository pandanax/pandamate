#!/bin/zsh

set -u

readonly PROJECT_DIR="/Users/pandanax/Yandex.Disk.localized/dev/pandamate"
readonly TMUX="/opt/homebrew/bin/tmux"
readonly LOG="/private/tmp/pandamate-launcher.log"
readonly SESSION_NAME="pandamate:home"
readonly WRITE_SESSION_NAME="pandamate:write"
readonly IDLE_PROBE_SESSION_NAME="pandamate:idle-probe"
readonly TUI_COMMAND="exec /bin/zsh -lc 'cd /Users/pandanax/Yandex.Disk.localized/dev/pandamate && source /Users/pandanax/.nvm/nvm.sh && nvm use >/dev/null && exec pnpm spike:tui:discovered'"
readonly IDLE_PROBE_COMMAND="exec /bin/zsh -lc 'cd /Users/pandanax/Yandex.Disk.localized/dev/pandamate && source /Users/pandanax/.nvm/nvm.sh && nvm use >/dev/null && exec pnpm spike:tui:idle -- --24h'"

exec >>"$LOG" 2>&1
print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) launcher.start"

function show_error() {
  local message="$1"
  /usr/bin/osascript - "$message" <<'APPLESCRIPT'
on run argv
  display alert "Pandamate could not start" message (item 1 of argv) as critical
end run
APPLESCRIPT
}

if [[ ! -x "$TMUX" ]]; then
  show_error "tmux was not found at $TMUX"
  exit 1
fi

if [[ ! -d "$PROJECT_DIR" ]]; then
  show_error "Project directory is missing: $PROJECT_DIR"
  exit 1
fi

function session_id() {
  local name="$1"
  "$TMUX" list-sessions -F '#{session_id}|#{session_name}' 2>/dev/null |
    /usr/bin/awk -F'|' -v name="$name" '$2 == name { print $1; exit }'
}

function wait_for_tui() {
  local session="$1"
  local attempt=0
  while (( attempt < 50 )); do
    if "$TMUX" capture-pane -p -t "$session" 2>/dev/null |
      /usr/bin/grep -q "PANDAMATE"; then
      return 0
    fi
    /bin/sleep 0.1
    (( attempt += 1 ))
  done
  return 1
}

function ensure_session() {
  local name="$1"
  local command="$2"
  local session
  session="$(session_id "$name")"
  if [[ -z "$session" ]]; then
    if ! "$TMUX" new-session -d -s "$name" "$command"; then
      show_error "tmux could not create $name. See $LOG"
      exit 1
    fi
    session="$(session_id "$name")"
  fi
  print -r -- "$session"
}

function idle_probe_is_running() {
  /bin/ps -axo command= 2>/dev/null |
    /usr/bin/grep -F "node src/idle-probe.ts -- --24h" |
    /usr/bin/grep -v grep >/dev/null
}

if ! /bin/zsh -lc \
  "cd '$PROJECT_DIR' && source /Users/pandanax/.nvm/nvm.sh && nvm use >/dev/null && pnpm pandamate daemon start"; then
  show_error "Pandamate daemon could not start. See $LOG"
  exit 1
fi

session="$(session_id "$SESSION_NAME")"
if [[ -n "$session" ]]; then
  "$TMUX" set-option -w -t "$session" remain-on-exit on
  if ! "$TMUX" respawn-pane -k -t "$session" "$TUI_COMMAND"; then
    show_error "tmux could not refresh $SESSION_NAME. See $LOG"
    exit 1
  fi
  "$TMUX" set-option -w -t "$session" remain-on-exit off
else
  session="$(ensure_session "$SESSION_NAME" "$TUI_COMMAND")"
fi

if [[ -z "$session" ]]; then
  show_error "Pandamate tmux session was not found after launch. See $LOG"
  exit 1
fi

write_session="$(session_id "$WRITE_SESSION_NAME")"
if [[ -n "$write_session" ]]; then
  "$TMUX" set-option -w -t "$write_session" remain-on-exit on
  if ! "$TMUX" respawn-pane -k -t "$write_session" "$TUI_COMMAND"; then
    show_error "tmux could not refresh $WRITE_SESSION_NAME. See $LOG"
    exit 1
  fi
  "$TMUX" set-option -w -t "$write_session" remain-on-exit off
else
  write_session="$(ensure_session "$WRITE_SESSION_NAME" "$TUI_COMMAND")"
fi
if [[ -n "$write_session" ]] && wait_for_tui "$write_session"; then
  "$TMUX" send-keys -t "$write_session" Escape
  "$TMUX" send-keys -t "$write_session" i
fi

idle_probe_session="$(session_id "$IDLE_PROBE_SESSION_NAME")"
if [[ -n "$idle_probe_session" ]] && ! idle_probe_is_running; then
  "$TMUX" kill-session -t "$idle_probe_session"
  idle_probe_session=""
fi
if [[ -z "$idle_probe_session" ]]; then
  idle_probe_session="$(
    ensure_session "$IDLE_PROBE_SESSION_NAME" "$IDLE_PROBE_COMMAND"
  )"
fi
print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) launcher.services write=$write_session idle_probe=$idle_probe_session"

if ! wait_for_tui "$session"; then
  show_error "Pandamate Home did not render in time. See $LOG"
  exit 1
fi
"$TMUX" send-keys -t "$session" Escape

/usr/bin/osascript - "$TMUX" "$session" <<'APPLESCRIPT'
on run argv
  set tmuxPath to item 1 of argv
  set sessionId to item 2 of argv
  set attachCommand to quoted form of tmuxPath & " attach-session -t " & quoted form of sessionId
  tell application "iTerm"
    activate
    set pandamateWindow to (create window with default profile)
    tell current session of pandamateWindow
      write text attachCommand
    end tell
  end tell
end run
APPLESCRIPT

print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) launcher.attached session=$session"
