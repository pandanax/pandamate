#!/bin/zsh

set -u

readonly PROJECT_DIR="/Users/pandanax/Yandex.Disk.localized/dev/pandamate"
readonly TMUX="/opt/homebrew/bin/tmux"
readonly LOG="/private/tmp/pandamate-launcher.log"
# A TUI that dies on startup takes its pane — and its stack trace — with it, so
# the launcher used to report only "did not render in time" with nothing to go
# on. Sending the TUI's stderr to a file that outlives the pane keeps the real
# cause (a dangling node_modules link, a failed `nvm use`, a bad cd) readable.
readonly TUI_LOG="/private/tmp/pandamate-tui.log"
readonly SESSION_NAME="pandamate:home"
readonly WRITE_SESSION_NAME="pandamate:write"
readonly IDLE_PROBE_SESSION_NAME="pandamate:idle-probe"
readonly TUI_COMMAND="exec /bin/zsh -lc 'cd /Users/pandanax/Yandex.Disk.localized/dev/pandamate && source /Users/pandanax/.nvm/nvm.sh && nvm use >/dev/null && exec pnpm spike:tui:discovered' 2>>$TUI_LOG"
readonly IDLE_PROBE_COMMAND="exec /bin/zsh -lc 'cd /Users/pandanax/Yandex.Disk.localized/dev/pandamate && source /Users/pandanax/.nvm/nvm.sh && nvm use >/dev/null && exec pnpm spike:tui:idle -- --24h' 2>>$TUI_LOG"

exec >>"$LOG" 2>&1
# One launch per file, so a failure is never buried under yesterday's output.
: >"$TUI_LOG" 2>/dev/null || true
print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) launcher.start"

function show_error() {
  local message="$1"
  /usr/bin/osascript - "$message" <<'APPLESCRIPT'
on run argv
  display alert "Pandamate could not start" message (item 1 of argv) as critical
end run
APPLESCRIPT
}

if [[ ! -x "$TMUX" ]]; then
  show_error "tmux was not found at $TMUX"
  exit 1
fi

if [[ ! -d "$PROJECT_DIR" ]]; then
  show_error "Project directory is missing: $PROJECT_DIR"
  exit 1
fi

function session_id() {
  local name="$1"
  "$TMUX" list-sessions -F '#{session_id}|#{session_name}' 2>/dev/null |
    /usr/bin/awk -F'|' -v name="$name" '$2 == name { print $1; exit }'
}

# Everything known about why a TUI did not come up, written where the error
# dialog already tells Panda to look.
function dump_diagnostics() {
  local target="$1"
  local label="$2"
  print -r -- "--- $label did not render: pane ---"
  "$TMUX" capture-pane -p -t "$target" 2>&1 | /usr/bin/tail -40
  print -r -- "--- $label did not render: tui stderr ($TUI_LOG) ---"
  /usr/bin/tail -40 "$TUI_LOG" 2>&1
  print -r -- "--- end $label ---"
}

function wait_for_tui() {
  local target="$1"
  local attempt=0
  while (( attempt < 50 )); do
    if "$TMUX" capture-pane -p -t "$target" 2>/dev/null |
      /usr/bin/grep -q "PANDAMATE"; then
      return 0
    fi
    /bin/sleep 0.1
    (( attempt += 1 ))
  done
  return 1
}

# Home also carries FirstMate tabs linked in from their own sessions. Targeting
# a bare session id would hit whichever tab is selected, so respawning the TUI
# that way killed the FirstMate living in it. The base window is the one this
# launcher owns: named `home`, otherwise the first window not linked from a
# FirstMate session. Empty when only FirstMate tabs are left.
function base_window() {
  local session="$1"
  "$TMUX" list-windows -t "$session" \
    -F '#{window_id}|#{window_linked}|#{window_name}' 2>/dev/null |
    /usr/bin/awk -F'|' '
      {
        if ($3 == "home" && home == "") home = $1
        if ($2 == 0 && plain == "") plain = $1
      }
      END { print (home != "" ? home : plain) }
    '
}

function ensure_session() {
  local name="$1"
  local command="$2"
  local session
  session="$(session_id "$name")"
  if [[ -z "$session" ]]; then
    if ! "$TMUX" new-session -d -s "$name" -n home "$command"; then
      show_error "tmux could not create $name. See $LOG"
      exit 1
    fi
    session="$(session_id "$name")"
  fi
  print -r -- "$session"
}

function idle_probe_is_running() {
  /bin/ps -axo command= 2>/dev/null |
    /usr/bin/grep -F "node src/idle-probe.ts -- --24h" |
    /usr/bin/grep -v grep >/dev/null
}

# Restart the daemon on every launch so the desktop shortcut always runs the
# current code from PROJECT_DIR. `daemon start` alone no-ops when an old daemon
# is already running, which is why launches kept booting the stale version.
if ! /bin/zsh -lc \
  "cd '$PROJECT_DIR' && source /Users/pandanax/.nvm/nvm.sh && nvm use >/dev/null && { pnpm pandamate daemon stop || true; } && pnpm pandamate daemon start"; then
  show_error "Pandamate daemon could not start. See $LOG"
  exit 1
fi

session="$(session_id "$SESSION_NAME")"
if [[ -n "$session" ]]; then
  home_window="$(base_window "$session")"
  if [[ -z "$home_window" ]]; then
    # Only FirstMate tabs left — the Home window was closed. Take index 0 back
    # instead of respawning into somebody else's FirstMate.
    home_window="$(
      "$TMUX" new-window -d -t "$session:0" -n home -P -F '#{window_id}' \
        "$TUI_COMMAND"
    )"
  else
    "$TMUX" set-option -w -t "$home_window" remain-on-exit on
    if ! "$TMUX" respawn-pane -k -t "$home_window" "$TUI_COMMAND"; then
      show_error "tmux could not refresh $SESSION_NAME. See $LOG"
      exit 1
    fi
    "$TMUX" set-option -w -t "$home_window" remain-on-exit off
  fi
  "$TMUX" set-window-option -t "$home_window" automatic-rename off
  "$TMUX" rename-window -t "$home_window" home
  "$TMUX" select-window -t "$home_window"
else
  session="$(ensure_session "$SESSION_NAME" "$TUI_COMMAND")"
  home_window="$(base_window "$session")"
fi

if [[ -z "$session" || -z "$home_window" ]]; then
  show_error "Pandamate tmux session was not found after launch. See $LOG"
  exit 1
fi

write_session="$(session_id "$WRITE_SESSION_NAME")"
if [[ -n "$write_session" ]]; then
  write_window="$(base_window "$write_session")"
  "$TMUX" set-option -w -t "$write_window" remain-on-exit on
  if ! "$TMUX" respawn-pane -k -t "$write_window" "$TUI_COMMAND"; then
    show_error "tmux could not refresh $WRITE_SESSION_NAME. See $LOG"
    exit 1
  fi
  "$TMUX" set-option -w -t "$write_window" remain-on-exit off
else
  write_session="$(ensure_session "$WRITE_SESSION_NAME" "$TUI_COMMAND")"
  write_window="$(base_window "$write_session")"
fi
if [[ -n "$write_window" ]]; then
  if wait_for_tui "$write_window"; then
    "$TMUX" send-keys -t "$write_window" Escape
    "$TMUX" send-keys -t "$write_window" i
  else
    # Non-fatal: Home still opens without the compose screen. Say so anyway —
    # a silently missing write service is easy to not notice for days.
    dump_diagnostics "$write_window" "write"
  fi
fi

idle_probe_session="$(session_id "$IDLE_PROBE_SESSION_NAME")"
if [[ -n "$idle_probe_session" ]] && ! idle_probe_is_running; then
  "$TMUX" kill-session -t "$idle_probe_session"
  idle_probe_session=""
fi
if [[ -z "$idle_probe_session" ]]; then
  idle_probe_session="$(
    ensure_session "$IDLE_PROBE_SESSION_NAME" "$IDLE_PROBE_COMMAND"
  )"
fi
print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) launcher.services write=$write_session idle_probe=$idle_probe_session"

if ! wait_for_tui "$home_window"; then
  dump_diagnostics "$home_window" "home"
  show_error "Pandamate Home did not render in time. See $LOG"
  exit 1
fi
"$TMUX" send-keys -t "$home_window" Escape

/usr/bin/osascript - "$TMUX" "$session" <<'APPLESCRIPT'
on run argv
  set tmuxPath to item 1 of argv
  set sessionId to item 2 of argv
  set attachCommand to quoted form of tmuxPath & " attach-session -t " & quoted form of sessionId
  tell application "iTerm"
    activate
    set pandamateWindow to (create window with default profile)
    tell current session of pandamateWindow
      write text attachCommand
    end tell
  end tell
end run
APPLESCRIPT

print -r -- "$(date -u +%Y-%m-%dT%H:%M:%SZ) launcher.attached session=$session"
